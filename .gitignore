.venv/
__pycache__/
.pytest_cache/
out/
state/
cache/
*.csv
*.csv.gz
*.jsonl.gz
.env
.claude/
.DS_Store
# small committed test fixtures are exempt from the bulk-data ignores above
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.csv.gz
!tests/fixtures/**/*.jsonl.gz

# local working notes
CHECKPOINT.md

# Bundled, pinned source snapshots ship with the code
!src/signalpost/caches/snapshot/*.jsonl.gz
data/*.ok
