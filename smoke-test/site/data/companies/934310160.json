          "c_cd1fa3a6fb89a30f617a",
          "c_831ffa2a75eb68e86694"
        ]
      },
      {
        "text": "VIVEL AS is a private limited company (AS), founded on 2024-10-07, registered in Ringerike.",
        "claim_ids": [
          "c_88d4871558e3906860c2",
          "c_05ec9303d62d81ada8e0",
          "c_9d88155f641d3a75ddea"
        ]
      },
      {
